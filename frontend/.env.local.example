# Public (inlined at Next.js build time — required for Docker/Render frontend builds)
# Production example: https://unisphere-api-c6la.onrender.com  (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8089

# Optional server-only override for proxy + server actions (runtime; no rebuild needed)
# Must be the live Express API that serves /api/v1/* (not the old /api/auth host).
# API_BASE_URL=https://unisphere-api-c6la.onrender.com

# Optional: enables live AI descriptions in admin Create Event
# Get a free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
